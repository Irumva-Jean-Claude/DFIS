# DFIS configuration template.
# Copy this file to .env and fill in your own values. NEVER commit the real .env.
# scripts\setup.ps1 does this for you and generates the secret keys automatically.
# Lines starting with # are optional; the value shown is the default.

# ---------------------------------------------------------------------------
# Security (required, keep secret)
# ---------------------------------------------------------------------------
# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DFIS_SECRET_KEY=CHANGE_ME_generate_a_random_64_char_key
# Seals PDF reports so they can be verified later. Auto-generated in the data
# folder if not set. Never change it after reports are issued, or old reports
# will no longer verify.
# DFIS_REPORT_SIGNING_KEY=
# Login session length and auto-logout after inactivity (minutes).
DFIS_ACCESS_TOKEN_MINUTES=30
# DFIS_SESSION_IDLE_MINUTES=30
# New self-registered accounts need admin approval before they can log in.
# DFIS_REQUIRE_USER_APPROVAL=false

# ---------------------------------------------------------------------------
# First administrator (used only when the database is created for the first
# time; change the password later inside DFIS, not here)
# ---------------------------------------------------------------------------
DFIS_ADMIN_USERNAME=admin
DFIS_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DFIS_DATABASE_URL=sqlite:///./backend/data/dfis.db
# PostgreSQL example: postgresql+psycopg2://dfis:CHANGE_ME@localhost:5432/dfis
# Folder for the database, evidence files and reports.
# DFIS_DATA_DIR=backend/data
DFIS_MAX_UPLOAD_MB=50
# How long evidence is retained (days). 2555 = about 7 years.
DFIS_RETENTION_DAYS=2555

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
DFIS_ORG_NAME=DFIS Academic Prototype
# DFIS_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Email notifications (optional; leave DFIS_SMTP_HOST empty to disable)
# ---------------------------------------------------------------------------
# DFIS_SMTP_HOST=smtp.example.com
# DFIS_SMTP_PORT=587
# DFIS_SMTP_USER=
# DFIS_SMTP_PASS=
# DFIS_SMTP_FROM=noreply@dfis.local
# DFIS_SMTP_TLS=true

# ---------------------------------------------------------------------------
# VirusTotal malware lookups (optional; get a free key at virustotal.com)
# ---------------------------------------------------------------------------
# DFIS_VIRUSTOTAL_KEY=

# ---------------------------------------------------------------------------
# AI model retraining (only for ml/train_model.py)
# ---------------------------------------------------------------------------
# DFIS_KDD_TRAIN=ml/data/KDDTrain.csv
# DFIS_KDD_TEST=ml/data/KDDTest.csv
